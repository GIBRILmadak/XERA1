{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/router.js": {
            "maxDuration": 60
        },
        "api/home.js": {
            "includeFiles": "client/dist/index.html"
        },
        "api/profile.js": {
            "includeFiles": "client/dist/index.html"
        }
    },
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/router?path=:path*"
        },
        {
            "source": "/assets/:path*",
            "destination": "/client/dist/assets/:path*"
        },
        {
            "source": "/medias/:path*",
            "destination": "/client/dist/medias/:path*"
        },
        {
            "source": "/index.html",
            "destination": "/app-legacy.html"
        },
        {
            "source": "/",
            "destination": "/api/home"
        },
        {
            "source": "/share/:path*",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/login",
            "destination": "/login.html"
        },
        {
            "source": "/explorer",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/arc/:id",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/u/:id",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/fata",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/creer/:type",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/messages",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/messages/:id",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/notifications",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/reglages",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/connexion",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/espace-createur",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/statistiques",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/live/:path*",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/talents",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/partenaires",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/pages/:path*",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/page/:path*",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/abonnements",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/subscription-plans",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/premium-plans",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/profile",
            "destination": "/api/profile"
        },
        {
            "source": "/profile/:path*",
            "destination": "/api/profile"
        },
        {
            "source": "/analytics",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/commissions",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/admin",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/badges-admin",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/create-stream",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/creator-dashboard",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/credits",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/stream",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/verification",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/cgu",
            "destination": "/cgu.html"
        },
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/404",
            "destination": "/404.html"
        },
        {
            "source": "/pagepro",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/pagepro/:path*",
            "destination": "/client/dist/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily",
            "schedule": "0 10 * * *"
        },
        {
            "path": "/api/cron/fata-worker",
            "schedule": "0 11 * * *"
        }
    ],
    "buildCommand": "npm --prefix client ci --no-audit --no-fund && npm --prefix client run build",
    "outputDirectory": "."
}
